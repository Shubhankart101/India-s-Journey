# Copy to .env (gitignored) and fill in. Django reads it on start; real environment variables win.
# Setup steps for both providers: docs/AUTHENTICATION.md
# Open the app at http://localhost:<port> (not 127.0.0.1); use the same port in the redirect URIs below.

# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Outlook.com, Hotmail, Live, Microsoft 365): https://entra.microsoft.com > App registrations
# Redirect URI (platform "Web"): http://localhost:8000/accounts/microsoft/login/callback/
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common = personal and work/school accounts; consumers = personal only; or a tenant ID
MICROSOFT_TENANT=common
