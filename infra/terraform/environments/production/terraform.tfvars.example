# Copy to terraform.tfvars (git-ignored) and fill in. Prefer TF_VAR_google_client_secret for secrets.
service_name     = "indias-journey"
render_plan      = "starter"
render_region    = "singapore"
disk_size_gb     = 1
custom_domains   = [] # e.g. ["data.example.in"]
maintenance_mode = false

google_client_id = "1234567890-abc.apps.googleusercontent.com"
# google_client_secret = set TF_VAR_google_client_secret instead

enable_microsoft          = true
allow_localhost_redirects = false
protect_default_branch    = false
