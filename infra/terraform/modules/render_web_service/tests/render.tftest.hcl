mock_provider "render" {}

run "defaults_wire_health_check_backup_and_disk" {
  command = plan

  assert {
    condition     = render_web_service.this.health_check_path == "/api/health/"
    error_message = "Render must probe the Django health endpoint."
  }

  assert {
    condition     = render_web_service.this.runtime_source.docker.dockerfile_path == "./Dockerfile"
    error_message = "Service must build from the repository Dockerfile."
  }

  assert {
    condition     = render_web_service.this.env_vars["BACKUP_SITE_URL"].value == "https://shubhankart101.github.io/India-s-Journey/"
    error_message = "Error pages must link to the GitHub Pages backup."
  }

  assert {
    condition     = render_web_service.this.env_vars["BACKUP_STATUS_URL"].value == "https://shubhankart101.github.io/India-s-Journey/status.html"
    error_message = "Status URL is derived from the backup URL."
  }

  assert {
    condition     = render_web_service.this.env_vars["DJANGO_SECRET_KEY"].generate_value == true
    error_message = "Secret key must be generated by Render, never committed."
  }

  assert {
    condition     = render_web_service.this.env_vars["DJANGO_SQLITE_PATH"].value == "/var/data/db.sqlite3"
    error_message = "SQLite must live on the persistent disk."
  }

  assert {
    condition     = render_web_service.this.disk.mount_path == "/var/data"
    error_message = "Disk mount path mismatch."
  }

  assert {
    condition     = render_web_service.this.maintenance_mode.enabled == false && render_web_service.this.maintenance_mode.uri == "https://shubhankart101.github.io/India-s-Journey/"
    error_message = "Maintenance mode must be off and point at the backup."
  }

  assert {
    condition     = !contains(keys(render_web_service.this.env_vars), "GOOGLE_CLIENT_ID") && !contains(keys(render_web_service.this.env_vars), "MICROSOFT_CLIENT_ID")
    error_message = "OAuth variables are only set when credentials are provided."
  }

  assert {
    condition     = !contains(keys(render_web_service.this.env_vars), "DJANGO_ALLOWED_HOSTS")
    error_message = "No custom domains means no ALLOWED_HOSTS override."
  }
}

run "oauth_domains_and_maintenance" {
  command = plan

  variables {
    google_client_id        = "g-id"
    google_client_secret    = "g-secret"
    microsoft_client_id     = "m-id"
    microsoft_client_secret = "m-secret"
    microsoft_tenant        = "consumers"
    custom_domains          = ["data.example.in"]
    maintenance_mode        = true
    disk_size_gb            = 0
  }

  assert {
    condition     = render_web_service.this.env_vars["GOOGLE_CLIENT_ID"].value == "g-id" && render_web_service.this.env_vars["MICROSOFT_CLIENT_ID"].value == "m-id"
    error_message = "OAuth client IDs must be passed through."
  }

  assert {
    condition     = render_web_service.this.env_vars["MICROSOFT_TENANT"].value == "consumers"
    error_message = "Tenant must be passed through."
  }

  assert {
    condition     = render_web_service.this.env_vars["DJANGO_ALLOWED_HOSTS"].value == "data.example.in"
    error_message = "Custom domain must be allowed."
  }

  assert {
    condition     = render_web_service.this.env_vars["DJANGO_CSRF_TRUSTED_ORIGINS"].value == "https://data.example.in"
    error_message = "Custom domain must be a trusted CSRF origin."
  }

  assert {
    condition     = render_web_service.this.disk == null && !contains(keys(render_web_service.this.env_vars), "DJANGO_SQLITE_PATH")
    error_message = "No disk when disk_size_gb = 0."
  }

  assert {
    condition     = render_web_service.this.maintenance_mode.enabled
    error_message = "Maintenance mode toggle must apply."
  }
}

run "rejects_unknown_region" {
  command = plan

  variables {
    region = "mumbai"
  }

  expect_failures = [var.region]
}
