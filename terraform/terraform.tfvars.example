# Copy to terraform.tfvars and customize
resource_group_name = "rg-indiasjourney"
location            = "centralindia"      # Central India (Pune)
app_name_prefix     = "indias-journey"
sku_name            = "B1"                # B1 = ~Rs. 1,100/mo (1 vCPU, 1.75 GB RAM)
docker_image        = "ghcr.io/shubhankart101/indias-journey:latest"
monthly_budget_inr  = 12500

# Optional: Add your email to receive Azure alerts at 80% (Rs. 10,000) and 100% (Rs. 12,500)
budget_alert_emails = [
  "admin@example.com"
]
